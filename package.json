{
	"name": "companion-mcp-server",
	"version": "5.1.0",
	"description": "Standalone MCP server for Bitfocus Companion 5.x: buttons, triggers, variables, connections and surfaces",
	"type": "module",
	"main": "dist/index.js",
	"bin": {
		"companion-mcp-server": "dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"build:ts": "tsc -p tsconfig.json",
		"dev": "tsx src/index.ts",
		"start": "node dist/index.js",
		"smoke": "node scripts/smoke.mjs",
		"prepublishOnly": "npm run build"
	},
	"keywords": [
		"mcp",
		"model-context-protocol",
		"bitfocus",
		"companion",
		"streamdeck"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/Weckmuller/companion-mcp-server.git"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.12.1",
		"@trpc/client": "^11.8.1",
		"@trpc/server": "^11.8.1",
		"ws": "^8.19.0",
		"zod": "^4.3.5"
	},
	"devDependencies": {
		"@types/node": "^24.0.0",
		"@types/ws": "^8.18.1",
		"tsx": "^4.21.0",
		"typescript": "~5.9.3"
	}
}
